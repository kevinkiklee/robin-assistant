#!/usr/bin/env sh
#
# Refuse to push personal data. Scans EVERY commit being pushed — content, message,
# and author/committer identity — so it also catches commits made with --no-verify,
# by `git commit-tree`, or by a tool that bypassed pre-commit. Fails closed: if the
# scanner can't run, the push is refused rather than sent unchecked.
#
# Git feeds one line per ref: <local ref> <local sha> <remote ref> <remote sha>.

zero=0000000000000000000000000000000000000000

if ! command -v node >/dev/null 2>&1 || [ ! -f system/scripts/private-scan.mjs ]; then
  echo "pre-push: refused — node or system/scripts/private-scan.mjs missing; can't verify." >&2
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a remote ref publishes nothing
  if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    from=$zero # new ref, or a remote tip we don't have: everything not already on a remote
  else
    from=$remote_sha
  fi
  node system/scripts/private-scan.mjs --range "$from" "$local_sha"
  status=$?
  if [ "$status" -ne 0 ]; then
    [ "$status" -eq 1 ] && echo "pre-push: refused — personal data in commits for $remote_ref." >&2
    [ "$status" -ne 1 ] && echo "pre-push: refused — private-scan failed (exit $status)." >&2
    exit 1
  fi
done

exit 0
